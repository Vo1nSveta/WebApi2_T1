@model List<WorkshopClientApp.Data.Workshop>

@{
    ViewData["Title"] = "Home Page";
}

<a href="/home/add"><button class="btn btn-success">Добавить цех</button></a>


<form method="post" class="row row-cols-lg-auto g-3 align-items-center mt-3">


    <div class="col-12">
        <input type="text" name="nameWorkshop" class="form-control" id="nameWorkshop" aria-describedby="emailHelp" placeholder="Название">
             
    </div>

    <div class="col-12">
        <input type="text" name="groupWorkshop" id="groupWorkshop" class="form-control" placeholder="Группа" aria-describedby="emailHelp">

    </div>

    <button type="submit" class="btn btn-primary row-cols-lg-auto g-3 align-items-center mt-3" style="color: black;">Поиск</button>


</form>

<table class="table">
    <tr>
        <th>Название</th>
        <th>Группа</th>
        <th>Действия</th>
    </tr>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.NameWorkshop</td>
            <td>@item.GroupWorkshop</td>
            <td>
                <a href="/home/edit/@item.Id">Редактировать</a>
                <a href="/home/remove/@item.Id" style="color: red;">Удалить</a>
            </td>
        </tr>
        
    }

  

</table>




