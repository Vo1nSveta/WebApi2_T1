@model List<WorkshopClientApp.Data.Equipment>

@{
    ViewData["Title"] = "Оборудование";
}

<a href="/home/addEquipment"><button class="btn btn-success">Добавить оборудование</button></a>


<form method="post" action="/Home/IndexEquipment"  class="row row-cols-lg-auto g-3 align-items-center mt-3">


    <div class="col-12">
        <input type="text" name="name" class="form-control" id="name" aria-describedby="emailHelp" placeholder="Оборудование">
             
    </div>

    
    <button type="submit" class="btn btn-primary row-cols-lg-auto g-3 align-items-center mt-3" style="color: black;">Поиск</button>


</form>

<table class="table">
    <tr>
        <th>Оборудование</th>
        <th>Действия</th>
    </tr>
    @if (Model != null)
    {
    @foreach(var item in Model)
        {
        <tr>
            <td>@item.Name</td>
            <td>
                    <a href="/home/editequipment/@item.Id">Редактировать</a>
                    <a href="/home/removeequipment/@item.Id" style="color: red;">Удалить</a>
            </td>
        </tr>
        
        }

   }

</table>




